datasource db {
  provider = "sqlite"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model Reservation {
  id             String   @id @default(uuid())
  name           String
  date           String
  time           String
  numberOfGuests Int
  status         String   // pending, confirmed, cancelled
  createdAt      DateTime @default(now())
}